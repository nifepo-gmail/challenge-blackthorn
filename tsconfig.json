{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@lib/*": ["lib/*"],
      "@tests/*": ["tests/*"]
    }
  },
  "include": ["src/**/*", "lib/**/*", "tests/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "allure-results", "allure-report"]
}
