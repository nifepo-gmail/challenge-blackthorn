# Environment variables for challenge-blackthorn
# Copy this file to .env and fill in values for local execution.
# In CI, set these as GitHub Actions secrets / environment variables.

# Target environment: local | pipeline
# Required — the project will throw on startup if this is not set.
ENV=local

# Base URL of the application under test.
# Defaults to https://www.saucedemo.com if not provided.
BASE_URL=https://www.saucedemo.com

# Base URL for the e-commerce REST API used in API tests.
# Defaults to https://fakestoreapi.com if not provided.
API_BASE_URL=https://fakestoreapi.com

# Slack webhook URL for CI notifications (feature/ci-pipeline branch only)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
